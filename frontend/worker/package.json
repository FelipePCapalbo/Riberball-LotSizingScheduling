{
  "name": "riberball-lotsizingscheduling-worker",
  "private": true,
  "scripts": {
    "build": "npm install --prefix ../app && npm run build --prefix ../app",
    "build:dev": "npm install --prefix ../app && npm run build:dev --prefix ../app",
    "dev": "wrangler dev --env dev",
    "dev:main": "wrangler dev --env=\"\"",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:dev": "wrangler deploy --env dev"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.0.0"
  }
}
